{
  "name": "specpilot-kit",
  "version": "0.7.0",
  "description": "A lightweight, repository-backed AI coding harness for Claude Code and Codex.",
  "keywords": [
    "spec-driven-development",
    "ai-coding-harness",
    "claude-code",
    "codex",
    "codegraph",
    "tdd"
  ],
  "license": "MIT",
  "author": "jianghuife",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jianghuife/SpecPilot.git"
  },
  "bugs": {
    "url": "https://github.com/jianghuife/SpecPilot/issues"
  },
  "homepage": "https://github.com/jianghuife/SpecPilot#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "specpilot": "bin/specpilot.js"
  },
  "exports": {},
  "files": [
    "dist",
    "bin",
    "assets",
    "runtime",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test/v05",
    "lint:fix": "eslint src test/v05 --fix",
    "format": "prettier --write src test/v05 runtime assets README.md",
    "format:check": "prettier --check src test/v05 runtime assets README.md",
    "prepack": "pnpm run build",
    "prepublishOnly": "node scripts/prepublish-check.js && pnpm run test && pnpm run build && npm pack --dry-run"
  },
  "lint-staged": {
    "{src,test/v05}/**/*.{ts,js,mjs,cjs,json,md,yaml,yml}": "prettier --write"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "commander": "^14.0.0",
    "yaml": "^2.8.1"
  }
}
